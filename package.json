{
  "name": "@moxtradeveloper/react-native-moxo-module",
  "version": "10.13.1",
  "description": "Plugin for adding Moxo services to React Native Apps.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "scripts",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!ios/Frameworks",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "postinstall": "node scripts/download-mepsdk.js",
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "del-cli android/build lib",
    "doc": "typedoc ./src/index.tsx --skipErrorChecking"
  },
  "keywords": [
    "moxo",
    "mep",
    "chat",
    "meet",
    "flow",
    "react-native",
    "ios",
    "android"
  ],
  "author": "Moxo Inc.",
  "license": "ISC",
  "bugs": {
    "url": "https://www.moxo.com"
  },
  "homepage": "https://www.moxo.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "pod-install": "^1.2.1",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "release-it": "^21.1.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "engines": {
    "node": ">= 22.13.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "moxoSdk": {
    "ios": {
      "version": "10.13.1",
      "downloadUrl": "https://mxrepo.moxo.com/repository/customer-raw-releases/mepsdk/dynamic/Dynamic_MEPSDK_iOS_v${version}.zip"
    }
  },
  "codegenConfig": {
    "name": "MoxoModuleSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.moxomodule"
    },
    "ios": {
      "modulesProvider": {
        "MoxoModule": "MoxoModule"
      }
    }
  }
}
